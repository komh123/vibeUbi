{
  "name": "vibeubi",
  "version": "0.1.0",
  "private": true,
  "description": "A deploy gate that removes the need to remember. Discovers every feature and every exposed port, refuses anything undeclared, proves the deploy from outside the process, and rolls back on a P0 red.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "vibeubi": "./bin/vibeubi.mjs",
    "ubi": "./bin/vibeubi.mjs"
  },
  "exports": {
    ".": {
      "types": "./packages/kernel/src/index.d.ts",
      "default": "./packages/kernel/src/index.mjs"
    },
    "./kernel": {
      "types": "./packages/kernel/src/index.d.ts",
      "default": "./packages/kernel/src/index.mjs"
    },
    "./viz": "./packages/viz/src/archify.mjs",
    "./adapters/*": "./packages/adapters/src/*",
    "./delivery": "./packages/ship/src/delivery.mjs",
    "./coverage-gap": "./packages/ship/src/coverage-gap.mjs",
    "./artifacts": "./packages/ship/src/artifacts.mjs"
  },
  "scripts": {
    "test": "node --test --test-reporter=tap packages/*/test/*.test.mjs",
    "test:evidence-mutations": "node scripts/check-evidence-mutations.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run test && npm run smoke",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "keywords": [
    "deploy",
    "gate",
    "testing",
    "coverage",
    "security",
    "agentic",
    "mcp",
    "rollback",
    "claude-code",
    "agent-skill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komh123/vibeUbi.git"
  },
  "types": "./packages/kernel/src/index.d.ts",
  "files": [
    "bin",
    "packages",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
